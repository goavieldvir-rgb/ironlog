# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings -> API -> Project URL / anon public key.
# .env.local is git-ignored, so your keys never get committed.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Cloudflare Turnstile site key for the captcha on the login screen.
VITE_TURNSTILE_SITE_KEY=
